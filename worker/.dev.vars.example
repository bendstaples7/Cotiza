# Required environment variables for local development
# Copy this file to .dev.vars and fill in the values

AI_TEXT_API_KEY=
FB_PAGE_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
CHANNEL_ENCRYPTION_KEY=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_ACCESS_TOKEN=
JOBBER_REFRESH_TOKEN=
JOBBER_WEB_EMAIL=
JOBBER_WEB_PASSWORD=

# Frontend URL for OAuth callback redirects (defaults to worker origin if unset)
# In production, set to the Cloudflare Pages URL (e.g., https://cotiza-e4h.pages.dev)
FRONTEND_URL=

# Cloudflare credentials for Browser Rendering REST API (automated cookie refresh)
# Get your account ID from the Cloudflare dashboard URL
# Create an API token with Browser Rendering - Edit permissions
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Dedicated key for pulling Gmail secrets into local .dev.vars (worker/scripts/pull-gmail-secrets.mjs).
# Set the same value in production via: wrangler secret put DEV_SECRETS_KEY
# Do NOT reuse CLOUDFLARE_API_TOKEN.
DEV_SECRETS_KEY=

# Optional: guards GET /health/pipelines (deep, read-only probes of OpenAI / GitHub
# cookie-refresh / Instagram Graph). Used by the post-deploy CI smoke test.
# When unset, /health/pipelines returns 503 (skipped) and CI skips the probe step.
# To enable: set the SAME value here, as a Worker secret (wrangler secret put
# HEALTHCHECK_KEY), and as a GitHub Actions repo secret named HEALTHCHECK_KEY.
HEALTHCHECK_KEY=

# Enable local-to-remote D1 sync (rules, cookies, tokens). Only set in .dev.vars, never in production.
# Does not bypass Jobber OAuth or session checks — reconnect via the app when tokens expire.
ENABLE_LOCAL_SYNC=true

# Gmail API credentials for email context enrichment (attach recent email conversations to quote generation)
# Required for email history on quote drafts. Copy values from production secrets or Google Cloud Console.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# GitHub repo slug (owner/name) for the cookie-refresh workflow dispatch.
# Defaults to the canonical repo in wrangler.toml; only override if your fork differs.
# GITHUB_REPO=bendstaples7/chicago-reno-social-generator
