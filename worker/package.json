{
  "name": "worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "sync-rules": "node scripts/sync-rules.mjs",
    "sync-rules:push": "node scripts/sync-rules.mjs --push",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy && node scripts/sync-rules.mjs --push && node scripts/sync-catalog.mjs --push",
    "sync-secrets": "node scripts/sync-secrets.mjs",
    "sync-secrets:dry-run": "node scripts/sync-secrets.mjs --dry-run",
    "pull-gmail-secrets": "node scripts/pull-gmail-secrets.mjs",
    "build": "tsc -b"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.99.0"
  }
}
